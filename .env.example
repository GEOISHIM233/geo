# ================================================================
#               BeZmerz - Environment Configuration
# ================================================================

# ===== DISCORD BOT =====
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# ===== AI PROVIDER (OpenRouter) =====
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_PROVIDER=openrouter
AI_MODEL=deepseek-r1
AI_BASE_URL=https://openrouter.ai/api/v1

# ===== DATABASE =====
DATABASE_URL=sqlite:///data/bezmerz.db
POSTGRES_URL=postgresql://bezmerz:bezmerz@localhost:5432/bezmerz

# ===== WEB / API =====
API_ENABLED=true
API_PORT=8000
DASHBOARD_API_KEY=your-secure-api-key-change-this
WEBHOOK_URL=
CMD_WEBHOOK_URL=

# ===== SERVER CONFIG =====
BOT_PREFIX=>
BOT_NAME=BeZmerz
BOT_DESCRIPTION=The ultimate multipurpose Discord bot with AI, moderation, and games
BOT_LANGUAGE=en
MAX_HISTORY=8
ALLOW_DM=true
SMART_MENTION=true

# ===== PRESENCE SETTINGS =====
PRESENCE_CHANGE_DELAY=8
DISABLE_PRESENCE=false

PRESENCES=
  - "Protecting your servers"
  - "In {guild_count} servers"
  - "Support at https://discord.gg/bezmerz"
  - "BeZmerz AI Assistant"

# ===== DISCORD LINKS =====
DISCORD_SERVER=https://discord.gg/bezmerz
SUPPORT_SERVER=https://discord.gg/bezmerz
YOUTUBE_CHANNEL=

# ===== BLACKLISTED WORDS =====
BLACKLIST_WORDS=
  - naked
  - loli
  - hentai
  - explicit
  - pornography
  - adult
  - XXX
  - sex
  - erotic

# ===== TRIGGER WORDS =====
TRIGGER=
  - chatbot
  - $
  - help
  - bot
  - bezmerz
