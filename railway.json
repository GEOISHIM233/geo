{
  "$schema": "https://railway.app/railway.schema.json",
  "name": "BeZmerz",
  "environments": {
    "production": {
      "memory": "1GB",
      "cpu": 1
    }
  },
  "services": [
    {
      "name": "bot",
      "type": "process",
      "start": "python bot/CodeX.py",
      "env": {
        "DISCORD_TOKEN": "$DISCORD_TOKEN",
        "OPENROUTER_API_KEY": "$OPENROUTER_API_KEY",
        "DATABASE_URL": "$DATABASE_URL"
      }
    }
  ]
}
